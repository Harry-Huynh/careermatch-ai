// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(uuid())
  name               String?
  email              String    @unique
  emailVerified      DateTime?
  image              String?

  passwordHash       String?
  provider           AuthProvider @default(CREDENTIALS)

  role               UserRole  @default(USER)
  dailyAnalysisLimit Int       @default(5)
  isBlocked          Boolean   @default(false)

  lastLoginAt        DateTime?
  lastLoginIp        String?

  accounts           Account[]
  sessions           Session[]
  usageLogs          UsageLog[]
  authEvents         AuthEvent[]

  resumes            Resume[]
  jobAnalyses        JobAnalysis[]

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model UsageLog {
  id        String      @id @default(uuid())
  userId    String
  action    UsageAction
  ipAddress String?
  userAgent String?
  deviceHash String?
  createdAt DateTime    @default(now())

  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([deviceHash, createdAt])
}

model AuthEvent {
  id         String        @id @default(uuid())
  userId     String?
  type       AuthEventType
  ipAddress  String?
  userAgent  String?
  deviceHash String?
  createdAt  DateTime      @default(now())

  user       User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([ipAddress, createdAt])
  @@index([deviceHash, createdAt])
}

model Resume {
  id        String   @id @default(uuid())
  userId    String
  name      String
  content   String

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyses  JobAnalysis[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
}

model JobAnalysis {
  id             String         @id @default(uuid())
  userId         String
  resumeId       String?

  jobTitle       String
  company        String
  jobDescription String

  fitScore       Int
  status         AnalysisStatus @default(DRAFT)

  summary        String
  strengths      String[]
  weaknesses     String[]

  coverLetterGuidance String[]

  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  resume         Resume?        @relation(fields: [resumeId], references: [id], onDelete: SetNull)

  skills         AnalysisSkill[]
  suggestions    AnalysisSuggestion[]
  questions      InterviewQuestion[]
  roadmapItems   RoadmapItem[]

  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([userId, createdAt])
  @@index([userId, fitScore])
  @@index([resumeId])
}

model AnalysisSkill {
  id         String        @id @default(uuid())
  analysisId String
  name       String
  type       SkillType

  analysis   JobAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  createdAt  DateTime      @default(now())

  @@index([analysisId])
  @@index([name])
  @@index([type])
}

model AnalysisSuggestion {
  id         String      @id @default(uuid())
  analysisId String
  content    String
  order      Int         @default(0)

  analysis   JobAnalysis @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
}

model InterviewQuestion {
  id         String        @id @default(uuid())
  analysisId String
  question   String
  type       QuestionType
  order      Int           @default(0)

  analysis   JobAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([type])
}

model RoadmapItem {
  id         String        @id @default(uuid())
  analysisId String
  content    String
  type       RoadmapType
  order      Int           @default(0)

  analysis   JobAnalysis   @relation(fields: [analysisId], references: [id], onDelete: Cascade)

  @@index([analysisId])
  @@index([type])
}

enum AuthProvider {
  CREDENTIALS
  GOOGLE
}

enum UserRole {
  USER
  ADMIN
}

enum UsageAction {
  JOB_ANALYSIS
  RESUME_PARSE
  COVER_LETTER
  INTERVIEW_PREP
}

enum AuthEventType {
  SIGNUP
  LOGIN
  LOGOUT
  GOOGLE_LOGIN
  FAILED_LOGIN
}

enum AnalysisStatus {
  DRAFT
  SAVED
  ARCHIVED
}

enum SkillType {
  MATCHED
  MISSING
  ATS_KEYWORD
}

enum QuestionType {
  TECHNICAL
  BEHAVIORAL
  PROJECT
}

enum RoadmapType {
  QUICK_WIN
  SHORT_TERM
  MEDIUM_TERM
}